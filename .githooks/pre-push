#!/usr/bin/env bash
#
# pre-push 钩子：推送前的三道护栏。
#
# 这个钩子存在的直接原因，是一次真实事故：
#   会话 A 在 19:50 新建了 V22__add_credit_delisted.sql（未提交）。
#   与此同时会话 B 在 19:47 已经提交并推送了 V23__update_unit_price_comment.sql。
#   两个会话共享同一个工作区，谁都没看到对方的文件。
#   结果：V22 在 V23 之后才要入库 → Flyway 判定 out-of-order → 已部署环境拒绝启动。
#   （最终处置：V22 重编为 V24，V22 作为永久空号在 DEV-GUIDE 中声明。）
#
# 三道护栏：
#   1. 禁止直推受保护分支（main），除非显式 ALLOW_PUSH_MAIN=1
#   2. Flyway 版本冲突检测 —— 新增迁移的版本号必须大于远端已有最大版本
#   3. 推送范围内的提交信息合规复查（本地改历史后 commit-msg 不会重跑）
#
# 刻意**不**在这里跑测试/构建：
#   pre-push 是同步阻塞的，跑 15 分钟单测的结果是人人都加 --no-verify。
#   测试在 CI，这里只做 3 秒内能完成的、CI 拦不住或拦晚了的事。

set -uo pipefail

PROTECTED_BRANCHES="main master"
ZERO="0000000000000000000000000000000000000000"
MIG_DIR="oaiss-chain-backend/src/main/resources/db/migration"

remote_name="${1:-origin}"

declare -a pushed_refs=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  pushed_refs+=("$local_ref|$local_sha|$remote_ref|$remote_sha")
done

if [ ${#pushed_refs[@]} -eq 0 ]; then
  exit 0
fi

fail=0

# ------------------------------------------------------------------
# 工具函数
# ------------------------------------------------------------------

version_of() {
  # V22__foo.sql -> 22 ；V29_1__foo.sql -> 29.1 ；不符合命名时输出空
  #
  # 为什么要支持小数版本：Flyway 的版本号允许 `29.1` 这种段（写成文件名是
  # V29_1__），它用来插队到 V29 与 V30 之间做数据前置修复。第一版正则只认
  # `^V([0-9]+)__`，于是 V29_1 解析为空 → 被判成「命名不合规」→ 整条推送
  # 被拦。实测复现：main 上 13 个待推提交全部推不出去。
  #
  # 文件名内的 `_` 是 Flyway 版本分隔符，转成 `.` 输出，便于人读与比较。
  local raw
  raw="$(basename "$1" | sed -nE 's/^V([0-9]+(_[0-9]+)*)__.*/\1/p')"
  [ -z "$raw" ] && return 0
  printf '%s' "${raw//_/.}"
}

ver_key() {
  # 把 "29" / "29.1" / "29.1.2" 压成定长整数，供数值比较。
  #
  # 为什么不能直接比字符串：字符串比较下 "29.1" > "30"（第二字符 '9' vs '0'），
  # 而数值上 29.1 < 30。Flyway 是按数值逐段比较的，护栏的比较口径必须一致，
  # 否则水位线判断会反向。
  local v="$1" major minor patch
  IFS='.' read -r major minor patch <<<"$v"
  printf '%d' "$(( ${major:-0} * 100000000 + ${minor:-0} * 10000 + ${patch:-0} ))"
}

# 计算「本次推送新增了什么」的基点。
#
# 坑：新建远端分支时 remote_sha 是全 0。若直接把 range 设成 HEAD，
# `git diff HEAD` 等于「与空树比较」——所有文件都算新增，于是会把
# 历史上每条迁移都当成「本次新增」、把每个历史提交都当成「本次推送
# 的不合规提交信息」，钩子变成对全仓历史的误报机器（实测复现过）。
#
# 正确做法：优先用 merge-base(远端 main, 本地推送的 commit)，
# 拿不到再退到「上一次可达提交」，而不是退回整个历史。
resolve_base() {
  local local_sha="$1" remote_sha="$2" remote_branch="$3"

  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    echo "$remote_sha"; return
  fi
  if git rev-parse --verify -q "refs/remotes/${remote_name}/main" >/dev/null 2>&1; then
    local mb
    mb="$(git merge-base "refs/remotes/${remote_name}/main" "$local_sha" 2>/dev/null)" || mb=""
    if [ -n "$mb" ]; then echo "$mb"; return; fi
  fi
  if [ -n "$remote_branch" ] && git rev-parse --verify -q "refs/remotes/${remote_name}/${remote_branch}" >/dev/null 2>&1; then
    local mb2
    mb2="$(git merge-base "refs/remotes/${remote_name}/${remote_branch}" "$local_sha" 2>/dev/null)" || mb2=""
    if [ -n "$mb2" ]; then echo "$mb2"; return; fi
  fi
  git rev-parse -q --verify "${local_sha}^" 2>/dev/null || echo "$ZERO"
}

# ------------------------------------------------------------------
# 护栏 1：受保护分支禁止直推
# ------------------------------------------------------------------
for entry in "${pushed_refs[@]}"; do
  IFS='|' read -r local_ref local_sha remote_ref remote_sha <<<"$entry"
  remote_branch="${remote_ref#refs/heads/}"
  for pb in $PROTECTED_BRANCHES; do
    if [ "$remote_branch" = "$pb" ] && [ "${ALLOW_PUSH_MAIN:-0}" != "1" ]; then
      cat >&2 <<EOF

✗ 拒绝直接推送到受保护分支：$pb

  原因：
    main 是发布基线。直推意味着「本地跑过就算过」——而本次诊断发现的
    连续 10 次 main 全红，正是这么来的：分支上不跑 CI，合进 main 才
    第一次看到红色，于是每一次修复都要等一轮 CI。

  正确做法：
    git switch -c feat/<scope>-<一句话>
    git push -u $remote_name feat/<scope>-<一句话>
    然后在 GitHub 开 PR —— PR 上会自动跑快速门禁 + 单元测试。

  确实需要直推（例如紧急回滚一个已发布的错误版本）：
    ALLOW_PUSH_MAIN=1 git push $remote_name $pb

EOF
      fail=1
    fi
  done
done

# ------------------------------------------------------------------
# 护栏 2：Flyway 版本冲突检测
# ------------------------------------------------------------------
# 远端 main 上已有的最大版本号，是本次推送新增迁移的「水位线」。
# 任何新增迁移的版本号 <= 水位线，都会在已部署环境触发 out-of-order。
check_migration_watermark() {
  local base_sha="$1"

  # watermark 同时保留「原始版本串」与「定长数值键」：
  # 前者用于给人看的报错文案，后者用于比较（小数版本不能按字符串比）。
  local watermark_raw=0 watermark=0
  if git rev-parse --verify -q "refs/remotes/${remote_name}/main" >/dev/null 2>&1; then
    while IFS= read -r f; do
      local v vk
      v="$(version_of "$f")"
      [ -z "$v" ] && continue
      vk="$(ver_key "$v")"
      if [ "$vk" -gt "$watermark" ]; then
        watermark=$vk
        watermark_raw=$v
      fi
    done < <(git ls-tree -r --name-only "refs/remotes/${remote_name}/main" -- "$MIG_DIR" 2>/dev/null)
  fi

  local range
  if [ "$base_sha" = "$ZERO" ]; then
    range="HEAD"
  else
    range="${base_sha}..HEAD"
  fi

  local added
  added="$(git diff --name-only --diff-filter=A "$range" -- "$MIG_DIR" 2>/dev/null || true)"
  [ -z "$added" ] && return 0

  # Flyway 的 out-of-order 开关决定「版本号小于水位线」到底是灾难还是允许的补跑。
  #
  # 这里必须读运行期配置，而不是一律硬拦。两种情形都是真实存在的：
  #   out-of-order=false（默认）→ 低版本迁移会让已部署环境**拒绝启动**，必须拦；
  #   out-of-order=true         → 项目明确接受乱序（V29_1 就是刻意为 V30 做前置
  #                                数据修复而插在水位线之下），此时硬拦等于让护栏
  #                                与实际策略互相矛盾：CI 全绿、本地却推不出去。
  local ooo=0
  for cand in oaiss-chain-backend/src/main/resources/application.yml \
              oaiss-chain-backend/src/main/resources/application.properties; do
    [ -f "$cand" ] || continue
    if grep -qE '^[[:space:]]*out-of-order:[[:space:]]*true' "$cand" 2>/dev/null; then
      ooo=1
    fi
  done
  local ooo_flag="$ooo"

  local bad=0
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    local v vk
    v="$(version_of "$f")"
    if [ -z "$v" ]; then
      echo "✗ 迁移文件命名不合规（应为 Vxx__desc.sql 或 Vxx_y__desc.sql）：$f" >&2
      bad=1
      continue
    fi
    vk="$(ver_key "$v")"
    if [ "$vk" -le "$watermark" ]; then
      if [ "$ooo_flag" = "1" ]; then
        cat >&2 <<EOF

⚠ Flyway 版本号低于水位线：$f

  该迁移版本 V$v，${remote_name}/main 上已有 V$watermark_raw。
  但本项目 application.yml 已显式开启 flyway.out-of-order，属**允许的补跑**，
  故只提示、不拦截。

  仍然提醒：乱序迁移只能用于「数据前置修复」这类幂等脚本，
  不能携带新的表结构依赖——它会在 V$watermark_raw 之后才执行。

EOF
        continue
      fi
      cat >&2 <<EOF

✗ Flyway 版本冲突：$f

  该迁移版本 V$v，但 ${remote_name}/main 上已有 V$watermark_raw。
  在已执行过 V$watermark_raw 的环境里，V$v 会被 Flyway 判定为 out-of-order，
  应用直接启动失败（不是告警，是拒绝启动）。

  为什么会发生：
    多个会话/多个人并行开发时，各自按本地看到的「最大号」+1，
    而本地未必包含对方刚推上去的那个版本号。

  正确做法（按顺序做，不要偷懒）：
    git fetch $remote_name
    ls $MIG_DIR | sort -V | tail -3      # 取真正的最大号
    git mv "$f" $MIG_DIR/V$(( ${watermark_raw%%.*} + 1 ))__<描述>.sql
    # 然后同步 DEV-GUIDE.md §11 的 Flyway 迁移行

  注意：若空号已经产生，**不要**去补空号。补空号等于让所有已部署环境炸掉；
  正确做法是把该号在 DEV-GUIDE 里声明为空号（门禁支持声明式跳号）。

EOF
      bad=1
    fi
  done <<< "$added"

  return $bad
}

for entry in "${pushed_refs[@]}"; do
  IFS='|' read -r local_ref local_sha remote_ref remote_sha <<<"$entry"
  [ "$local_sha" = "$ZERO" ] && continue
  remote_branch="${remote_ref#refs/heads/}"
  base="$(resolve_base "$local_sha" "$remote_sha" "$remote_branch")"
  check_migration_watermark "$base" || fail=1
done

# ------------------------------------------------------------------
# 护栏 3：推送范围内的提交信息复查
# ------------------------------------------------------------------
# commit-msg 只在「新建提交」时跑。rebase / amend / cherry-pick 之后，
# 历史里可能混入不合规信息，而那时钩子已经不会再触发。
# 注意：PATTERN 内不能再放行首锚点 ^。它被拼进 "^[0-9a-f]+ ${PATTERN}"，
# 中间出现第二个 ^ 会让整条正则永不匹配——表现是「所有提交都不合规」，
# 钩子对任何人都报错（第一版就是这么写错的，靠负向测试才抓到）。
MSG_TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
MSG_PATTERN="(${MSG_TYPES})(\([a-zA-Z0-9._/-]+\))?!?: .+"

for entry in "${pushed_refs[@]}"; do
  IFS='|' read -r local_ref local_sha remote_ref remote_sha <<<"$entry"
  [ "$local_sha" = "$ZERO" ] && continue
  remote_branch="${remote_ref#refs/heads/}"
  base="$(resolve_base "$local_sha" "$remote_sha" "$remote_branch")"

  if [ "$base" = "$ZERO" ]; then
    range="$local_sha"
  else
    range="${base}..${local_sha}"
  fi

  bad_msgs="$(git log --format='%h %s' "$range" 2>/dev/null \
    | grep -vE '^[0-9a-f]+ (Merge|Revert|fixup!|squash!)' \
    | grep -vE "^[0-9a-f]+ ${MSG_PATTERN}" || true)"
  if [ -n "$bad_msgs" ]; then
    echo "" >&2
    echo "✗ 推送范围内存在不符合 Conventional Commits 的提交：" >&2
    echo "$bad_msgs" | sed 's/^/    /' >&2
    echo "" >&2
    echo "  修正：git rebase -i <基点> 改写信息后重推。" >&2
    echo "  （.githooks/commit-msg 只拦新建提交，改历史后需在此复查）" >&2
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  exit 1
fi

# ------------------------------------------------------------------
# 护栏 4：远端基线漂移（提交前预检）
# ------------------------------------------------------------------
# 2026-11-04 事故：本地 main 积压 26 个提交且未 fetch，远端同期经 PR 推进。
# 两侧各自独立实现了同一批需求，试合并产生 8 处冲突（含 3 个 add/add）。
#
# 前面三道护栏都拦不住这种形态：
#   1 只看「推到哪个分支」，不看基线是否过期
#   2 只看「迁移版本号」，不看同一需求被两边各写一遍
#   3 只看「信息格式」，不看内容是否已与他人分叉
#
# 所以推之前再问一次「你是不是在过期基线上工作」。
# 默认只对非 main 分支提示、不阻塞：这是「早发现」不是「晚拦截」，
# 真正需要硬拦时用 REQUIRE_UP_TO_DATE=1（CI/发布前推荐）。
PREFLIGHT="scripts/agent/preflight.mjs"
if command -v node >/dev/null 2>&1 && [ -f "$PREFLIGHT" ]; then
  behind_detail="$(node "$PREFLIGHT" --json 2>/dev/null || true)"
  if [ -n "$behind_detail" ]; then
    behind_count="$(printf '%s' "$behind_detail" | node -e '
      let s = ""
      process.stdin.on("data", (d) => (s += d)).on("end", () => {
        try { console.log(JSON.parse(s).divergence?.behind ?? 0) } catch { console.log(0) }
      })
    ' 2>/dev/null || echo 0)"
    if [ "${behind_count:-0}" -gt 0 ]; then
      echo "" >&2
      echo "⚠ 当前分支落后 origin/main ${behind_count} 个提交。" >&2
      echo "  在漂移的基线上开发，容易与远端已合并的改动各自实现同一件事" >&2
      echo "  （本仓 2026-11-04 就因此产生过 8 处合并冲突）。" >&2
      echo "  建议：git fetch origin && git rebase origin/main" >&2
      echo "" >&2
      if [ "${REQUIRE_UP_TO_DATE:-0}" = "1" ]; then
        echo "✗ REQUIRE_UP_TO_DATE=1，拒绝在过期基线上推送。" >&2
        fail=1
      fi
    fi
  fi
fi

if [ "$fail" -ne 0 ]; then
  exit 1
fi

echo "✓ pre-push 检查通过（分支保护 / Flyway 水位线 / 提交信息）"
exit 0
