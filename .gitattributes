# Auto detect text files and perform LF normalization
* text=auto

# Java sources
*.java text diff=java
*.xml text
*.yml text
*.yaml text

# Frontend sources
*.ts text
*.vue text
*.js text
*.css text
*.html text
*.json text
*.md text

# Shell scripts
*.sh text eol=lf
*.mjs text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Docker
Dockerfile text
docker-compose*.yml text

# Kubernetes
*.yaml text

# SQL
*.sql text diff=sql

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.jar binary