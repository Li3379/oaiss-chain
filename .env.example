# =============================================
# OAISS Chain - Environment Variables Template
# Copy to .env for local/dev, or use .env.prod.example for production.
# Never commit real secrets.
# =============================================

# ===== Runtime Profile =====
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# ===== Database (MySQL) =====
# Local/dev can use DB_HOST/DB_PORT. Production should prefer DB_URL with TLS.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oaiss_chain
DB_USERNAME=root
DB_PASSWORD=change_me_db_password
# DB_URL=jdbc:mysql://mysql.example.internal:3306/oaiss_chain?useSSL=true&requireSSL=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=20
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_LEAK_DETECTION_MS=0
# prod-only HikariCP 调优（application-prod.yml 引用；本地无需设）
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_MAX_LIFETIME_MS=1800000

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=change_me_redis_password
# prod-only（application-prod.yml 引用）
REDIS_TIMEOUT_MS=10000

# ===== JWT Authentication =====
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_random_256bit_secret
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ===== RSA Key Encryption Key (AES-256-GCM) =====
# Must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
RSA_KEK=change_me_base64_encoded_32_byte_key

# ===== S3 Object Storage (LocalStack in dev; MinIO-compatible S3 API) =====
# 注：变量前缀仍为 MINIO_（后端沿用 MinIO SDK 直连标准 S3 API），
#     但本地容器已由 minio/minio 迁至 localstack/localstack:3（镜像已下架）。
MINIO_ENDPOINT=http://localhost:9004
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_BUCKET=oaiss-chain
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600
# prod-only（application-prod.yml 引用）
MINIO_MAX_FILE_SIZE_BYTES=104857600

# ===== Runtime / Server =====
# prod-only：优雅停机超时（application-prod.yml 引用）
SERVER_SHUTDOWN_TIMEOUT=30s
# release compose 挂载的容器日志目录（docker-compose.release.yml 引用）
BACKEND_LOG_DIR=./runtime-logs/backend
FRONTEND_LOG_DIR=./runtime-logs/frontend
ML_LOG_DIR=./runtime-logs/ml-service

# ===== ML Service (Python FastAPI) =====
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_SECRET=
ML_SERVICE_CONNECT_TIMEOUT=5s
ML_SERVICE_READ_TIMEOUT=30s
# Copilot LLM（可选）：留空则一律走内置 GB/T 32150-2015 规则引擎，响应体如实标注未调用大模型
# 填入 LLM_API_KEY 后按 OpenAI 兼容协议调用 LLM_API_BASE/LLM_MODEL；密钥只放本机 .env，勿提交仓库
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 本地 Ollama 同样可选：填入地址后才会被探测（如 http://host.docker.internal:11434/v1）
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ===== 登录验证码 =====
# 默认 true：登录必须携带 captcha + captchaKey。
# 运行 scripts/api/*.sh 集成测试脚本时请设为 false——这些脚本不传验证码，
# 在 true 下会全部以 2006「验证码错误」失败。生产环境必须保持 true。
SECURITY_CAPTCHA_ENABLED=true

# ===== 碳配额发放（组件 1）=====
# 默认 false。审核通过时是否按「发电量 × 行业基准值」发放配额。
#
# 为什么默认关：存量报告在 V25 之前没有 output_quantity / unit_type /
# period_year 三个字段（都是本轮才加的），打开后每一份历史报告的审核都会在
# 前置校验阶段失败（「发电量缺失」），审核流程整体停摆。
#
# 上线顺序：① 回填存量报告的产量与机组类型 → ② 管理员录入当年基准值
# （GET /admin/benchmarks/readiness?year=2026 应返回 ready=true）→ ③ 再打开本开关。
QUOTA_ALLOCATION_ENABLED=false

# ===== Grafana / Alerting =====
REQUIRE_OPS_SECRETS=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
ALERT_SMTP_HOST=
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# ===== Fabric (Blockchain) =====
FABRIC_ENABLED=false
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=carbon-chaincode
# 链码版本标签（仅作标签：包内容始终来自 oaiss-chain-chaincode 源码挂载）。
# sequence 由 bootstrap-fabric.sh 依网络已提交序号自动 +1，无需手工设置。
# 链码源码变更时上调此值即可触发重部署。
FABRIC_CHAINCODE_VERSION=1.2
FABRIC_PEER_ENDPOINT=
FABRIC_TLS_ENABLED=true
FABRIC_PEER_TLS_CERT_PATH=
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
FABRIC_CA_ENABLED=false
FABRIC_CA_ENDPOINT=
FABRIC_CA_ADMIN_NAME=admin
FABRIC_CA_ADMIN_PASSWORD=change_me_fabric_ca_password
FABRIC_COUCHDB_USER=admin
FABRIC_COUCHDB_PASSWORD=change_me_couchdb_password
# prod-only：网关超时与 secrets 挂载（application-prod.yml / docker-compose.release.yml 引用）
FABRIC_CONNECT_TIMEOUT_SECONDS=30
FABRIC_SUBMIT_TIMEOUT_SECONDS=60
FABRIC_SECRETS_DIR=
FABRIC_SECRETS_MOUNT_PATH=/run/secrets/fabric
