<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs 精确排除清单。

  原则（与 static-analysis-ratchet 一致）：只排除「确定的误报」，不排除「改起来麻烦的真问题」。
  每一条都必须写明为什么在这里判为误报，否则下一个人无法判断能否删除。

  基线棘轮不会因为本文件而放宽：被排除的条目根本不计入总数。
-->
<FindBugsFilter>
    <!--
      Lombok @Builder 生成的 Builder 类持有字段引用（EI_EXPOSE_REP2）。

      这不是设计缺陷：构造器接收集合后立刻写入新实例，Builder 本身是一次性的
      中间对象，不对外暴露、不被缓存。SpotBugs 看不到 Lombok 生成代码的语义，
      按普通 Pojo 的 getter/setter 规则报出。

      只匹配 `$XxxBuilder` 生成类，不涉及任何手写类。
    -->
    <Match>
        <Class name="~.*\$.*Builder" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>

    <!--
      TradeAuditService#quotaLedgerService：Spring 构造器注入的只读单例依赖，
      本类生产路径**不调用**它（成交结算已改走碳币）。

      为什么注入而不删：TradeAuditServiceTest 有 9 处
      verify(quotaLedgerService, never())——那是「配额退出资产层」这一
      2026-11-03 模型变更的可执行证据。删掉依赖字段会让这些断言变成编译错误，
      等于把「没有回退到配额账本」的守护一起删掉。

      EI_EXPOSE_REP2 的本意是「把可变对象存进字段后外部仍可改」，而 Spring
      注入的单例本就不该被外部持有者修改。只匹配这一个字段，不放大到整个类。
    -->
    <Match>
        <Class name="com.oaiss.chain.service.TradeAuditService" />
        <Field name="quotaLedgerService" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
</FindBugsFilter>
